  "music": {
    "prompts": [
      {
        "text": "Wind chimes and low synth pad, a small boat on the open sea at night, the moon on the water",
        "weight": 1.0
      },
      {
        "text": "Solo cello, long low phrases, something following far behind a boat in the dark, restrained",
        "weight": 0.8
      },
      {
        "text": "Glassy harmonium drones with the hiss of water along a hull, slow and wide, almost still",
        "weight": 0.8
      },
      {
        "text": "Sparse felt piano, three notes and a long pause, cold clear night air, gentle unease",
        "weight": 0.5
      },
      {
        "text": "Low drone of a foghorn-like brass note under thin high violins, a cold presence on the water",
        "weight": 0.4
      },
      {
        "text": "Solo nylon-string guitar picking a slow, plain northern folk tune, close and intimate, sea wind behind it",
        "weight": 0
      },
      {
        "text": "Soft accordion holding long quiet chords, a little out of breath, dawn over a calm sea",
        "weight": 0
      },
      {
        "text": "Music box playing a lullaby slightly out of tune, a mother asleep in a boat",
        "weight": 0
      },
      {
        "text": "Kantele plucked softly, open fifths, Nordic folk, bright and bare",
        "weight": 0
      },
      {
        "text": "Brushed snare and upright bass, a slow cheerful waltz, a family on a boat trip",
        "weight": 0
      },
      {

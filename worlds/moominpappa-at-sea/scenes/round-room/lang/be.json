{"strings": [
  {"text":"27 August. Wind north. Today I am forty. Nobody knows.","translation":"27 жніўня. Вецер норд. Мне сёння сорак. Ніхто не ведае.","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Ate bread. Whose, I don't know.","translation":"З'еў хлеб. Чый — не ведаю.","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Calm. The sea is good today.","translation":"Штыль. Мора сёння добрае.","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Ice on the steps. Wind north.","translation":"На прыступках лёд. Вецер норд.","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Fog. Heard a ship. It did not come.","translation":"Туман. Чуў судна. Не падышло.","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Wind south-west. Nobody again.","translation":"Вецер зюйд-вест. Зноў ніхто.","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"23 August. Arrived.","translation":"23 жніўня. Прыбылі.","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Depth: more than the rope.","translation":"Глыбіня: больш за вяроўку.","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"27 August. Calm.","translation":"27 жніўня. Ціха.","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"The Round Room","translation":"Круглы пакой","where":"worlds/moominpappa-at-sea/scenes/round-room/scene.json title"},
  {"text":"The round room at the foot of the lighthouse.","translation":"Круглы пакой ля падножжа маяка.","where":"worlds/moominpappa-at-sea/scenes/round-room/scene.json caption"}
]}

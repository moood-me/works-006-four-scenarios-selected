{"strings": [
  {"text":"27 August. Wind north. Today I am forty. Nobody knows.","translation":"8月27日。北風。今天我四十歲了。沒有人知道。","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Ate bread. Whose, I don't know.","translation":"吃了麵包。誰的，不知道。","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Calm. The sea is good today.","translation":"無風。今天的海很好。","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Ice on the steps. Wind north.","translation":"台階上結了冰。北風。","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Fog. Heard a ship. It did not come.","translation":"起霧。聽見一艘船。沒有靠過來。","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Wind south-west. Nobody again.","translation":"西南風。又是沒有人。","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"23 August. Arrived.","translation":"8月23日。抵達。","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"Depth: more than the rope.","translation":"深度：比繩子還深。","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"27 August. Calm.","translation":"8月27日。平靜。","where":"worlds/moominpappa-at-sea/scenes/round-room/elements/wall_a.js"},
  {"text":"The Round Room","translation":"圓形房間","where":"worlds/moominpappa-at-sea/scenes/round-room/scene.json title"},
  {"text":"The round room at the foot of the lighthouse.","translation":"燈塔底層的圓形房間。","where":"worlds/moominpappa-at-sea/scenes/round-room/scene.json caption"}
]}

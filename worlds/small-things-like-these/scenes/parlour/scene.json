  "music": {
    "prompts": [
      {
        "text": "Solo cello, slow and low, a held open fifth under a plain modal melody, cold stone, December before dawn",
        "weight": 0.5
      },
      {
        "text": "Sparse felt piano, single notes with long silences, frost, a small Irish town asleep",
        "weight": 0.4
      },
      {
        "text": "Uilleann pipes very far off, a slow air, mist over a river",
        "weight": 0
      },
      {
        "text": "Low string drone, almost still, the hiss of steam behind a wall",
        "weight": 0.6
      },
      {
        "text": "Harmonium chord held like breath, a convent chapel, restrained",
        "weight": 0.9
      },
      {
        "text": "Solo violin, a slow air in the Irish style, plaintive, no ornament",
        "weight": 0
      },
      {
        "text": "Distant church bell partials blended into soft pads, cold air",
        "weight": 0.3
      },
      {
        "text": "Fingerpicked nylon guitar, tender and hesitant, a man who says little",
        "weight": 0
      },
      {
        "text": "Clarinet low register, slow, warm against cold, quiet kindness",
        "weight": 0
      },
      {
        "text": "Choir humming a carol very softly from far away, Christmas, heavy",
        "weight": 0
      },
      {
        "text": "Tin whistle, a few notes, wistful, like breath on frost",
        "weight": 0
      },
      {
        "text": "Bowed vibraphone shimmer, ice, stillness, glass",
        "weight": 0
      },
      {
        "text": "Muted brass chorale, slow, solemn, small town grief",
        "weight": 0
      },
      {
        "text": "Ambient field-like texture of water and wind, river at night, minimal",
        "weight": 0
      },
      {
        "text": "Neo-classical piano and string quartet, restrained, Max Richter-like, compassion",
        "weight": 0
      },
      {
        "text": "Bodhran heartbeat very soft under a drone, tension held",
        "weight": 0
      },
      {
        "text": "A clock ticking in a quiet room, a soft low pulse under held strings, polite and cold",
        "weight": 0.7
      }
    ],

  {"text":"Finale","translation":"","where":"games/moominpappa-at-sea/bespoke/game.js"},
  {"text":"decided late","translation":"","where":"games/moominpappa-at-sea/bespoke/game.js"},
  {"text":"in full","translation":"","where":"games/moominpappa-at-sea/bespoke/game.js"},
  {"text":"Replay","translation":"","where":"games/moominpappa-at-sea/bespoke/map.js"},
  {"text":"continue\nthe replay","translation":"","where":"games/moominpappa-at-sea/bespoke/map.js"},
  {"text":"the author’s map","translation":"","where":"games/moominpappa-at-sea/bespoke/map.js"},
  {"text":"After Him","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/after.js"},
  {"text":"A boy with a lantern, and steps behind him.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/after.js"},
  {"text":"The Armful","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/armful.js"},
  {"text":"Seaweed higher than his head.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/armful.js"},
  {"text":"Asleep","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/asleep.js"},
  {"text":"A creak, and a hand on the lantern.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/asleep.js"},
  {"text":"The beam goes round.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/beam.js"},
  {"text":"As Far as the Dune","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/beside.js"},
  {"text":"Two in the moonlight, one a little ahead.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/beside.js"},
  {"text":"The Boat","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/boat.js"},
  {"text":"A heavy boat, and two pulling.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/boat.js"},
  {"text":"The Burner, and Run","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/burner.js"},
  {"text":"The Burner","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/burner.js"},
  {"text":"The burner — and the door banging below.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/burner.js"},
  {"text":"The burner, the storm, and the last paraffin.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/burner.js"},
  {"text":"Below, the door has banged.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/burner.js"},
  {"text":"The flame has turned blue.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/burner.js"},
  {"text":"The Can","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/can.js"},
  {"text":"A full can, and a high threshold.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/can.js"},
  {"text":"The Door","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/door.js"},
  {"text":"Pines against the door.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/door.js"},
  {"text":"Dust","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/dust.js"},
  {"text":"Dust by the floor, and a line under it.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/dust.js"},
  {"text":"The Door in the Storm","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/hold.js"},
  {"text":"A door, and the sea behind it.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/hold.js"},
  {"text":"Holding Him","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/keep.js"},
  {"text":"A paw on a small shoulder.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/keep.js"},
  {"text":"The Knot","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/knot.js"},
  {"text":"A net pulled into a knot.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/knot.js"},
  {"text":"The Ladle","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/ladle.js"},
  {"text":"A thread of smoke out of the moss under the apple tree.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/ladle.js"},
  {"text":"Ow","who":"papa","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/ladle.js"},
  {"text":"The Lantern","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/lantern.js"},
  {"text":"One handle, and two paws on it.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/lantern.js"},
  {"text":"The boy’s paw pulls at the handle.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/lantern.js"},
  {"text":"The Lead","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/lead.js"},
  {"text":"A rope with a weight, and black water with no bottom.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/lead.js"},
  {"text":"The Match","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/match.js"},
  {"text":"A wick, a match, and a draught from the gallery.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/match.js"},
  {"text":"The Matchbox","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/matches.js"},
  {"text":"A matchbox, and a hand that does not take it.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/matches.js"},
  {"text":"The palm lies open under the box.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/matches.js"},
  {"text":"The stone beside him is bare.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/matches.js"},
  {"text":"The Mooring","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/mooring.js"},
  {"text":"A mooring line, and a quiet sea.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/mooring.js"},
  {"text":"The boat tugs at the line.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/mooring.js"},
  {"text":"The Palm","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/palm.js"},
  {"text":"A painted gate, and plaster under the paw.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/palm.js"},
  {"text":"To the Cape","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/pie.js"},
  {"text":"Bread, and the rocks to the cape.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/pie.js"},
  {"text":"A pie, and the rocks to the cape.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/pie.js"},
  {"text":"You’ll drop it","who":"my","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/pie.js"},
  {"text":"Over the Rocks","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/rocks.js"},
  {"text":"Rocks, foam, and a lantern in the wind.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/rocks.js"},
  {"text":"The Shoulder","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/shoulder.js"},
  {"text":"The shoulder stirs under the paw.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/shoulder.js"},
  {"text":"The Stair","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/stair.js"},
  {"text":"The middle of the stair.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/stair.js"},
  {"text":"Half a Light","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/steady.js"},
  {"text":"Steady","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/steady.js"},
  {"text":"A low flame, and grey grooves.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/steady.js"},
  {"text":"Soot on the wall, and pencil under it.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/steady.js"},
  {"text":"The Thread","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/thread.js"},
  {"text":"A needle, a thread, and big paws.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/thread.js"},
  {"text":"The Tiller","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/tiller.js"},
  {"text":"A star over the bow, and three waves coming.","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/tiller.js"},
  {"text":"Just as planned","who":"papa","translation":"","where":"games/moominpappa-at-sea/bespoke/minigames/tiller.js"},
  {"text":"narrator","translation":"","where":"games/moominpappa-at-sea/bespoke/people.json.narrator short"},
  {"text":"Papa","translation":"","where":"games/moominpappa-at-sea/bespoke/people.json.papa short"},
  {"text":"Mama","translation":"","where":"games/moominpappa-at-sea/bespoke/people.json.mama short"},
  {"text":"Moomintroll","translation":"","where":"games/moominpappa-at-sea/bespoke/people.json.troll short"},
  {"text":"My","translation":"","where":"games/moominpappa-at-sea/bespoke/people.json.my short"},
  {"text":"Fisherman","translation":"","where":"games/moominpappa-at-sea/bespoke/people.json.fisher short"},
  {"text":"Mama’s garden","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Mama in her garden","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Mama with us","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Mama’s garden — how much she has painted. It grows when she has time alone, it shrinks when Papa is beside her.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"The lamp","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Papa at the lamp","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Papa with his own","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"The lamp — the sheets by the burner: each one an evening given to the lamp, not to his own.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Paraffin","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"A measure of paraffin burnt","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Paraffin — three measures in the can, one full lantern a night. No sailing for more while the crests are white.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"The Groke’s nights","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"A night of light for the Groke","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"The Groke’s nights — nights she was given light. The more, the nearer she sits.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Mama will remember: you decided for everyone.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Mama will remember: you asked her.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Moomintroll will remember: his father gave him the lantern.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"The Fisherman will remember: the new keepers.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"The Fisherman will remember: he was called.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"The Fisherman will remember: someone sat beside him.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Papa promised: “Till I light it, I sleep by the lamp.”","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Papa promised: “Not lit by the full moon — we turn for home.”","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Papa promised: “I won’t ask.”","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Papa knows the line of 27 August.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Mama will remember: he turned away.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Mama will remember: he called her.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Mama will remember: he waited.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Moomintroll will remember: “Later.”","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"},
  {"text":"Moomintroll has shut himself away.","translation":"","where":"games/moominpappa-at-sea/bespoke/story.js"}
]}
